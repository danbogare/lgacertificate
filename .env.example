NODE_ENV=development
# Reverse proxies in front of the app (defaults to 1 on Heroku or in production)
TRUST_PROXY=
PORT=4000
APP_URL=http://localhost:4000
FRONT_END_URL=http://localhost:3000

MONGO_URI=
JWT_SECRET=
CERTIFICATE_SECRET=

APP_ADMIN_NAME=
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

SMTP_HOST=
SMTP_USER_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FLW_URI=
FLW_SECRET=
# Charges added to what the payer pays (defaults: 2%, no flat fee, capped at 2000 naira, plus 7.5% VAT on the charge)
FLW_CHARGE_PERCENT=2
FLW_CHARGE_FLAT=0
FLW_CHARGE_CAP=2000
FLW_CHARGE_VAT_PERCENT=7.5

PARTNER_BASE_URL=
PARTNER_API_KEY=
PARTNER_MERCHANT_ID=
PARTNER_SECRET=
# Defaults: 15 naira flat, no percentage, no cap, no VAT
PARTNER_CHARGE_PERCENT=0
PARTNER_CHARGE_FLAT=15
PARTNER_CHARGE_CAP=
PARTNER_CHARGE_VAT_PERCENT=0
